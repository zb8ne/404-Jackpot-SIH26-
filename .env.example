# Copy to .env, or let Doppler inject these:  doppler run -- docker compose up
#
# Supabase — the project the backend verifies access tokens against.
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional Supabase user ids. Profiles are provisioned only for non-empty ids,
# so a partial local demo can run with the accounts available to that developer.
# The full seeded-document demo still needs all three department Admins.
SEED_BIRTH_USER_ID=
SEED_TRANSPORT_USER_ID=
SEED_EDUCATION_USER_ID=
SEED_BIRTH_OFFICIAL_USER_ID=
SEED_CONTROLLER_USER_ID=

# Optional display addresses for those admins.
SEED_BIRTH_EMAIL=birth.admin@example.test
SEED_TRANSPORT_EMAIL=transport.admin@example.test
SEED_EDUCATION_EMAIL=education.admin@example.test
SEED_BIRTH_OFFICIAL_EMAIL=birth.official@example.test
SEED_CONTROLLER_EMAIL=controller@example.test

# Optional access tokens for those same three Admins. The document seeder runs
# only when all three are set because its lifecycle fixture spans all three
# departments. These are short-lived JWTs and must be refreshed before a seeded
# run. The rest of the stack starts without them.
SEED_BIRTH_TOKEN=
SEED_TRANSPORT_TOKEN=
SEED_EDUCATION_TOKEN=

# Published host ports. Override when something already owns one.
ANVIL_PORT=8545
API_PORT=8088
WEB_PORT=5173

# Ownership for generated files. Match your host user so demo-files stays yours.
HOST_UID=1000
HOST_GID=1000
