# Copy to .env, or let Doppler inject these:  doppler run -- docker compose up
#
# Supabase — the project the backend verifies access tokens against.
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase user ids for the three department admins. Created once per project;
# these are stable.
SEED_BIRTH_USER_ID=
SEED_TRANSPORT_USER_ID=
SEED_EDUCATION_USER_ID=

# Optional display addresses for those admins.
SEED_BIRTH_EMAIL=birth.admin@example.test
SEED_TRANSPORT_EMAIL=transport.admin@example.test
SEED_EDUCATION_EMAIL=education.admin@example.test

# Access tokens for those same three admins, used by the document seeder because
# it issues through the real REST API. These are short-lived JWTs: they expire in
# about an hour, so they have to be refreshed before each seeded run.
SEED_BIRTH_TOKEN=
SEED_TRANSPORT_TOKEN=
SEED_EDUCATION_TOKEN=

# Published host ports. Override when something already owns one.
ANVIL_PORT=8545
API_PORT=8088
WEB_PORT=5173

# Ownership for generated files. Match your host user so demo-files stays yours.
HOST_UID=1000
HOST_GID=1000
